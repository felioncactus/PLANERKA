NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/planorka

JWT_SECRET=replace_with_32_plus_random_characters
JWT_EXPIRES_IN=7d

# Email delivery for verification and password recovery
# In development, codes are printed to the server console if SMTP is not configured.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="PLANERKA <no-reply@example.com>"

# Optional, only needed if your React static site is on a different host from the API.
# Point the client VITE_UPLOADS_BASE_URL at the public API origin, for example:
# https://your-api-service.onrender.com

# OpenAI
OPENAI_API_KEY=your_key_if_using_ai_features
OPENAI_MODEL=gpt-4o-mini
